<Project>
    <!-- Target Frameworks -->
    <Import Project="$(MSBuildThisFileDirectory)../build/TargetFrameworks.props" />

    <!-- XUnit -->
     <Import Project="$(MSBuildThisFileDirectory)../build/XUnit.props" />

     <PropertyGroup>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath>$(MSBuildThisFileDirectory)../artifacts/test</ArtifactsPath>
    </PropertyGroup>

</Project>