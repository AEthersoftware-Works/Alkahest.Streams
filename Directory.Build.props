<Project>
    <Import Project="$(MSBuildThisFileDirectory)Directory.Version.props" />
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- <TreatWarningsAsErrors>True</TreatWarningsAsErrors> -->
    </PropertyGroup>

    <PropertyGroup>
        <BuildNumber>$(BuildID)</BuildNumber>
        <Revision>$(Rev:rr)</Revision>
        <!-- Fallbacks -->
        <BuildNumber Condition="'$(BuildNumber)' == ''">$([System.DateTime]::Now.ToString('yyMMdd'))</BuildNumber>
        <Revision Condition="'$(Revision)' == ''">$([System.DateTime]::Now.ToString('HH'))</Revision>
    </PropertyGroup>

    <PropertyGroup>
        <LocalNuGetPublishDestination>$(NUGET_DEFAULT_PUSH_SOURCE)</LocalNuGetPublishDestination>
        <LocalNuGetPublishDestination Condition="'$(LocalNuGetPublishDestination)' == ''">$(MSBuildThisFileDirectory)/.local-nuget</LocalNuGetPublishDestination>
    </PropertyGroup>

    <!-- Shared Package info -->
    <PropertyGroup>
        <Authors>Aether Software Works, Alkahest.Streams Contributors</Authors>
        <PackageProjectUrl>https://github.com/AEthersoftware-Works/Alkahest.Streams</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AEthersoftware-Works/Alkahest.Streams</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PackageLicense>Apache-2.0</PackageLicense>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false"/>
    </ItemGroup>

    <!-- Documentation config -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- <DocumentationFile>$(SolutionDir)build\Alkahest.Streams.xml</DocumentationFile> -->
        <!-- See https://github.com/NuGet/Home/issues/6001 -->
        <NoWarn>NU5118</NoWarn>
        <!-- <NoWarn>$(NoWarn);NU5118;1591</NoWarn> -->
    </PropertyGroup>
</Project>