<Project>
    <!-- Package/Assembly Versioning -->
    <Import Project="$(MSBuildThisFileDirectory)build/Version.props" />

    <!-- Shared Package info -->
    <Import Project="$(MSBuildThisFileDirectory)build/Package.props"/>

    <!-- Target Frameworks -->
    <Import Project="$(MSBuildThisFileDirectory)build/TargetFrameworks.props" />

    <!-- Documentation config -->
    <Import Project="$(MSBuildThisFileDirectory)build/Docs.props" />

    <!-- SBOM (Release targeted builds) -->
    <Import Project="$(MSBuildThisFileDirectory)build/BillOfMaterials.props" />

    <!-- Nullable Enable -->
    <Import Project="$(MSBuildThisFileDirectory)build/NullableEnable.props" />

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/src</ArtifactsPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Staging'">
        <OutputPath>bin\Staging\</OutputPath>
        <DefineConstants>STAGING</DefineConstants>
    </PropertyGroup>
</Project>