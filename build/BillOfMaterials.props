<Project>

    <Choose>
        <When Condition="'$(Configuration)' == 'Release'">
            <PropertyGroup>
                <GenerateSBOM>true</GenerateSBOM>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.4" PrivateAssets="All" />
            </ItemGroup>
        </When>
    </Choose>

</Project>