<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="alkahest-local-dev-folder" value="./.local-nuget" />
        <!-- 
        Local NuGet feed options
        You can also run your own local feed using BaGet! 
        See: https://loic-sharma.github.io/BaGet/
        -->
        <add key="alkahest-local-dev-baget" value="http://localhost:5555/v3/index.json" allowInsecureConnections="true" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <activePackageSource>
        <add key="All" value="(Aggregate source)" />
    </activePackageSource>
    <auditSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </auditSources>
    <config>
        <!-- Configure using .env.local -->
        <add key="defaultPushSource" value="%NUGET_DEFAULT_PUSH_SOURCE%" />
    </config>
</configuration>