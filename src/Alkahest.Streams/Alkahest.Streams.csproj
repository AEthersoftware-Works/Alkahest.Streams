<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- <TargetFramework>net10.0</TargetFramework> -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Alkahest.Streams</RootNamespace>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Alkahest.Streams</PackageId>
    <Title>Alkahest.Streams</Title>
    <Product>Alkahest.Streams</Product>
    <Description>Universal stream transmutation. High-throughput pipelines for compression, encryption, and beyond.</Description>
    <Summary>Universal stream transmutation. High-throughput pipelines for compression, encryption, and beyond.</Summary>
    <PackageTags>Alkahest;Alkahest.Streams;Streams;IO</PackageTags>
    <PackageIcon>alkahest-streams-nuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Alkahest.Streams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/alkahest-streams-nuget.png" Pack="true" PackagePath="" Visible="false">
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Events/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
</Project>
