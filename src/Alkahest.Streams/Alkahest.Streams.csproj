<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- <TargetFrameworks>net462;netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks> -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Alkahest.Streams</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Alkahest.Streams</PackageId>
    <PackageVersion>$(VersionPrefix).$(BuildNumber)-rc-$(Revision)</PackageVersion>
    <Title>Alkahest.Streams</Title>
    <Description>Universal stream transmutation. High-throughput pipelines for compression, encryption, and beyond.</Description>
    <PackageTags>Alkahest;Alkahest.Streams;Streams;IO</PackageTags>
    <PackageIcon>alkahest-streams-nuget.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Alkahest.Streams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/alkahest-streams-nuget.png" Pack="true" PackagePath="" Visible="false">
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Events/" />
  </ItemGroup>

</Project>
